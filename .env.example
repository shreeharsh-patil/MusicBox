JIOSAAVN_DES_KEY=38346591
JIOSAAVN_REFERER=https://www.jiosaavn.com/
JIOSAAVN_ORIGIN=https://www.jiosaavn.com
JIOSAAVN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
JIOSAAVN_ALLOWED_DOMAINS=aac.saavncdn.com,c.saavncdn.com,saavncdn.com,jiotunepreview.jio.com
